# SQLite file. In Docker this lives on the /data volume.
DATABASE_PATH=./data/courts.db

# Start the in-process scheduler (one replica only).
SYNC_ENABLED=true

# live = production schedules (ActiveNet every 15 min, etc.); on boot, only re-fetches data that missed a scheduled run.
# gentle = slow schedules and no re-fetch on boot when data is under a day old.
# Defaults to live when NODE_ENV=production, gentle otherwise.
SYNC_PROFILE=gentle

# Sent in the User-Agent of every upstream request so the Township can identify the app.
APP_CONTACT_URL=https://github.com/Johnnyracket/woodlands-court-finder

# Optional: ArcGIS Location Platform key for Esri's light-gray basemap.
# Without it the map uses muted OpenStreetMap tiles.
NEXT_PUBLIC_ARCGIS_API_KEY=

# AI assistant: off until set to true (baked in at build time). Needs ANTHROPIC_API_KEY.
NEXT_PUBLIC_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
