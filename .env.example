# SQLite file. In Docker this lives on the /data volume.
DATABASE_PATH=./data/courts.db

# Start the in-process scheduler (one replica only).
SYNC_ENABLED=true

# Sent in the User-Agent of every upstream request so the Township can identify the app.
APP_CONTACT_URL=https://github.com/your-name/woodlands-court-finder

# Used by the AI assistant (step 8).
ANTHROPIC_API_KEY=
